{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://denker.local/sdd/context/context-request.schema.json",
  "title": "Internal local reader request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question", "focus", "files", "max_output_tokens"],
  "properties": {
    "schema_version": {"const": "2"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "focus": {
      "enum": ["structure", "behavior", "dependencies", "tests", "risks"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ranges"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start_line", "end_line"],
              "properties": {
                "start_line": {"type": "integer", "minimum": 1},
                "end_line": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 600}
  }
}
